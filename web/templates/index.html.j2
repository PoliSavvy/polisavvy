<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PoliSavvy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#f7f5f0; --card:#ffffff; --ink:#1d1b1a; --ink-2:#4a4744; --muted:#7a7570;
    --line:#e4e0d8; --accent:#5b3f6b; --accent-soft:#efe9f2; --done:#1d1b1a; --good:#2f6b4f; --good-soft:#e6f1eb;
  }
  @media (prefers-color-scheme: dark){
    :root{ --paper:#141313; --card:#1e1c1c; --ink:#f2efe9; --ink-2:#c9c4bc; --muted:#8f8a83;
      --line:#2f2c2b; --accent:#c9a8dc; --accent-soft:#2c2331; --done:#f2efe9; --good:#7cc4a0; --good-soft:#1c2b24; }
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
  .wrap{max-width:680px;margin:0 auto;padding:0 18px 110px}
  header{padding:24px 0 14px}
  .brand span{color:var(--accent)}
  .brand{font-family:"Source Serif 4",Georgia,serif;font-weight:700;font-size:28px;letter-spacing:-.01em;margin:0}
  .tag{color:var(--ink-2);margin:4px 0 0;font-size:15px}
  .edition{display:inline-block;margin-top:10px;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);background:var(--accent-soft);padding:4px 10px;border-radius:999px}

  .view{display:none}
  .view.on{display:block;animation:fade .2s ease}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

  .brief{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;margin:12px 0 4px}
  .kicker{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 8px;font-weight:700}
  .brief ul{margin:0;padding-left:18px}
  .brief li{margin:6px 0}

  .chips{display:flex;gap:8px;overflow-x:auto;padding:14px 0 4px;scrollbar-width:none}
  .chips::-webkit-scrollbar{display:none}
  .chip{flex:none;border:1px solid var(--line);background:var(--card);color:var(--ink-2);font:500 14px Inter,sans-serif;padding:8px 14px;border-radius:999px;cursor:pointer}
  .chip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}

  .item{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;margin:14px 0}
  .meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-bottom:8px}
  .status{font-weight:700;letter-spacing:.05em;text-transform:uppercase;font-size:11px;padding:3px 8px;border-radius:6px;border:1px solid var(--ink);color:var(--ink)}
  .status.law{background:var(--ink);color:var(--paper)}
  h3{font-family:"Source Serif 4",Georgia,serif;font-size:22px;line-height:1.25;margin:0 0 10px;font-weight:700}
  .label{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:14px 0 4px}
  .item p{margin:0;color:var(--ink-2)}
  .you{background:var(--accent-soft);border-radius:12px;padding:12px 14px;margin-top:14px}
  .you .label{margin-top:0;color:var(--accent)}
  .you p{color:var(--ink)}

  .track{display:flex;margin:18px 0 4px;padding:0;list-style:none}
  .track li{flex:1;position:relative;text-align:center;font-size:11px;color:var(--muted);padding-top:18px;line-height:1.25}
  .track li::before{content:"";position:absolute;top:4px;left:50%;transform:translateX(-50%);width:10px;height:10px;border-radius:50%;border:2px solid var(--line);background:var(--card);z-index:1}
  .track li::after{content:"";position:absolute;top:9px;left:-50%;width:100%;height:2px;background:var(--line)}
  .track li:first-child::after{display:none}
  .track li.done::before{background:var(--done);border-color:var(--done)}
  .track li.done::after,.track li.now::after{background:var(--done)}
  .track li.now::before{border-color:var(--accent);background:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
  .track li.now{color:var(--accent);font-weight:700}
  .track li.done{color:var(--ink-2)}

  details{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}
  summary{cursor:pointer;font-weight:600;font-size:14px;list-style:none;display:flex;justify-content:space-between;align-items:center}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";font-size:20px;color:var(--muted);font-weight:400}
  details[open] summary::after{content:"\2212"}
  .sides{display:grid;gap:10px;margin-top:10px}
  .side{border-left:3px solid var(--line);padding:2px 0 2px 12px;font-size:15px;color:var(--ink-2)}
  .side b{display:block;color:var(--ink);font-size:13px}
  .note{font-size:12px;color:var(--muted);margin-top:8px}

  .poll{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}
  .poll .q{font-weight:700;font-size:14px;margin-bottom:8px}
  .poll .opts{display:flex;gap:8px}
  .poll button{flex:1;padding:10px 6px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:600 14px Inter,sans-serif;cursor:pointer}
  .poll button.picked{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  .poll .reveal{display:none;margin-top:10px;background:var(--good-soft);border-radius:10px;padding:10px 12px;font-size:14px;color:var(--ink)}
  .poll.answered .reveal{display:block}

  .src{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:14px;font-weight:600;color:var(--accent);text-decoration:none}
  .src:hover{text-decoration:underline}
  .term{background:none;border:0;padding:0;font:inherit;color:inherit;border-bottom:1.5px dotted var(--accent);cursor:help}

  .small{display:flex;gap:12px;align-items:baseline;font-size:15px;color:var(--ink-2)}
  h2.section{font-family:"Source Serif 4",Georgia,serif;font-size:20px;margin:26px 0 6px}

  /* PM timeline */
  .tl{list-style:none;margin:8px 0 0;padding:0;position:relative}
  .tl::before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:2px;background:var(--line)}
  .tl li{position:relative;padding:0 0 18px 28px}
  .tl li::before{content:"";position:absolute;left:1px;top:6px;width:14px;height:14px;border-radius:50%;background:var(--card);border:2px solid var(--ink)}
  .tl li.now::before{background:var(--accent);border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
  .tl li.next::before{border-style:dashed;border-color:var(--muted)}
  .tl .when{font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
  .tl .where{font-weight:700}
  .tl .what{color:var(--ink-2);font-size:15px}

  /* Lobbying */
  .stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
  .stat{background:var(--paper);border-radius:12px;padding:12px 14px}
  .stat .n{font-size:28px;font-weight:800;letter-spacing:-.02em}
  .stat .d{font-size:13px;color:var(--ink-2);line-height:1.35}
  .bars{margin-top:8px;display:grid;gap:8px}
  .bar{display:grid;grid-template-columns:130px 1fr 48px;align-items:center;gap:10px;font-size:14px}
  .bar .t{height:10px;border-radius:5px;background:var(--line);overflow:hidden}
  .bar .f{height:100%;background:var(--accent);border-radius:5px}
  .bar .v{text-align:right;font-variant-numeric:tabular-nums;color:var(--ink-2)}
  .meet{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-top:10px}
  .meet .who{font-weight:700}
  .meet .with{font-size:14px;color:var(--ink-2);margin-top:4px}
  .pill{display:inline-block;font-size:12px;padding:2px 8px;border-radius:999px;background:var(--paper);border:1px solid var(--line);margin:6px 4px 0 0;color:var(--ink-2)}

  /* Learn */
  .quiz .qq{display:none}
  .quiz .qq.on{display:block}
  .quiz .qtext{font-weight:700;font-size:17px;margin:6px 0 12px}
  .quiz .ans{display:grid;gap:8px}
  .quiz .ans button{text-align:left;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:500 15px Inter,sans-serif;cursor:pointer}
  .quiz .ans button.right{background:var(--good-soft);border-color:var(--good);color:var(--ink)}
  .quiz .ans button.wrong{opacity:.55;text-decoration:line-through}
  .quiz .why{display:none;margin-top:10px;font-size:14px;color:var(--ink-2)}
  .quiz .qq.done .why{display:block}
  .quiz .nav{display:flex;justify-content:space-between;align-items:center;margin-top:14px;font-size:13px;color:var(--muted)}
  .btn{padding:10px 16px;border-radius:10px;border:0;background:var(--ink);color:var(--paper);font:600 14px Inter,sans-serif;cursor:pointer}
  .btn:disabled{opacity:.35;cursor:default}
  .meter{height:10px;background:var(--line);border-radius:5px;overflow:hidden;margin-top:10px}
  .meter i{display:block;height:100%;width:0;background:var(--good);transition:width .3s}
  .glossary{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  .glossary button{padding:8px 12px;border-radius:999px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:500 14px Inter,sans-serif;cursor:pointer}
  .glossary button.seen{border-color:var(--good);background:var(--good-soft)}
  .how ol{padding-left:20px;color:var(--ink-2);margin:6px 0 0}
  .how li{margin:6px 0}
  .cta{display:block;text-align:center;margin-top:12px;padding:13px;border-radius:12px;background:var(--accent);color:#fff;font-weight:700;text-decoration:none}
  @media (prefers-color-scheme: dark){ .cta{color:#1e1c1c} }

  footer{margin-top:30px;padding-top:16px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}

  /* bottom tabs */
  .tabs{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);display:flex;justify-content:center;z-index:5;padding-bottom:env(safe-area-inset-bottom)}
  .tabs .in{display:flex;width:100%;max-width:680px}
  .tabs a{flex:1;text-align:center;padding:10px 4px 12px;font-size:12px;font-weight:600;color:var(--muted);text-decoration:none}
  .tabs a svg{display:block;margin:0 auto 3px;width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .tabs a.on{color:var(--accent)}

  .sheet-bg{position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;align-items:flex-end;justify-content:center;z-index:10}
  .sheet-bg.open{display:flex}
  .sheet{background:var(--card);width:100%;max-width:680px;border-radius:18px 18px 0 0;padding:22px 22px 30px}
  .sheet h4{margin:0 0 6px;font-family:"Source Serif 4",Georgia,serif;font-size:20px}
  .sheet p{margin:0;color:var(--ink-2)}
  .sheet button{margin-top:16px;width:100%;padding:12px;border-radius:10px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:600 15px Inter,sans-serif;cursor:pointer}

  /* account / follow */
  .follow{margin-left:auto;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:600 12px Inter,sans-serif;padding:5px 10px;border-radius:999px;cursor:pointer}
  .follow.on{background:var(--accent);border-color:var(--accent);color:#fff}
  .steps{display:flex;gap:6px;margin:4px 0 14px}
  .steps i{flex:1;height:4px;border-radius:2px;background:var(--line)}
  .steps i.on{background:var(--accent)}
  .field{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:500 16px Inter,sans-serif}
  .topics{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
  .topics button{padding:9px 13px;border-radius:999px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:500 14px Inter,sans-serif;cursor:pointer}
  .topics button.on{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  .radio{display:grid;gap:8px;margin-top:6px}
  .radio label{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border:1px solid var(--line);border-radius:12px;cursor:pointer;background:var(--paper)}
  .radio label:has(input:checked){border-color:var(--accent);background:var(--accent-soft)}
  .radio small{display:block;color:var(--muted);font-size:13px}
  .check{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--ink-2);margin-top:14px}
  .row{display:flex;gap:10px;margin-top:16px}
  .row .btn{flex:1;padding:13px}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
  .err{color:#b3402f;font-size:13px;margin-top:6px;min-height:1em}
  .mail{border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:12px}
  .mail .hd{background:var(--paper);padding:10px 14px;font-size:13px;color:var(--muted);border-bottom:1px solid var(--line)}
  .mail .bd{padding:14px}
  .mail .bd h4{font-family:"Source Serif 4",Georgia,serif;font-size:19px;margin:0 0 8px}
  .mail .it{padding:10px 0;border-top:1px solid var(--line)}
  .mail .it:first-of-type{border-top:0}
  .mail .it b{display:block}
  .mail .it span{font-size:14px;color:var(--ink-2)}
  .mail .tg{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--accent);margin-bottom:2px}
  .demo{font-size:12px;color:var(--muted);text-align:center;margin-top:10px}
  .toast{position:fixed;left:50%;bottom:86px;transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:10px 16px;border-radius:999px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s;z-index:20}
  .toast.show{opacity:1}

  /* daily 5 */
  .d5head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
  .d5head h3{margin:2px 0 0}
  .streak{flex:none;text-align:center;background:var(--paper);border-radius:12px;padding:8px 12px;min-width:64px}
  .streak b{display:block;font-size:22px;line-height:1.1}
  .streak span{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em}
  .dots{display:flex;gap:6px;margin:14px 0 4px}
  .dots i{flex:1;height:6px;border-radius:3px;background:var(--line)}
  .dots i.ok{background:var(--good)} .dots i.no{background:#c0563f} .dots i.cur{background:var(--accent)}
  .qtype{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);background:var(--accent-soft);padding:3px 8px;border-radius:6px;margin-top:8px}
  .hl{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .hl button{padding:20px 10px!important;text-align:center!important;font-size:17px!important;font-weight:700!important}
  .order-pick{display:flex;flex-wrap:wrap;gap:8px;min-height:44px;padding:8px;border:1px dashed var(--line);border-radius:12px;margin-bottom:10px}
  .order-pick span{background:var(--ink);color:var(--paper);border-radius:999px;padding:6px 12px;font-size:14px;font-weight:600}
  .order-pick em{color:var(--muted);font-size:14px;font-style:normal;padding:6px 4px}
  .linkish{background:none;border:0;color:var(--accent);font:600 14px Inter,sans-serif;cursor:pointer;padding:0}
  .result{text-align:center;padding:6px 0 2px}
  .result .big{font-family:"Source Serif 4",Georgia,serif;font-size:34px;font-weight:700}
  .result .grid{font-size:28px;letter-spacing:4px;margin:6px 0}
  .result .sub{color:var(--ink-2)}
  .sgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:16px 0 6px;text-align:center}
  .sgrid b{display:block;font-size:22px}
  .sgrid span{font-size:11px;color:var(--muted);line-height:1.2;display:block}
  .dist{display:grid;gap:5px;margin-top:6px}
  .dist div{display:grid;grid-template-columns:16px 1fr;gap:8px;align-items:center;font-size:13px}
  .dist i{display:block;height:18px;border-radius:4px;background:var(--line);color:var(--ink);font-style:normal;font-size:12px;font-weight:700;text-align:right;padding-right:6px;line-height:18px;min-width:22px}
  .dist i.me{background:var(--good);color:#fff}
  .countdown{font-variant-numeric:tabular-nums;font-weight:700}
  .banner{display:flex;align-items:center;gap:14px;text-decoration:none;color:inherit;background:var(--ink);color:var(--paper);border-radius:16px;padding:16px 18px;margin:12px 0 4px}
  .banner .t{flex:1}
  .banner b{display:block;font-size:16px}
  .banner small{opacity:.75;font-size:13px}
  .banner .go{background:var(--paper);color:var(--ink);font-weight:700;font-size:14px;padding:8px 14px;border-radius:999px}
  .switch{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line);font-size:14px}
  [hidden]{display:none!important}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1 class="brand">Poli<span>Savvy</span></h1>
  <p class="tag">Politics, minus the spin. What Canada's federal government did, explained like a normal person would, with every item linked to the official record.</p>
  <span class="edition">{{ edition_label }}</span>
</header>

<!-- ============ TODAY ============ -->
<section class="view" id="v-today">
  <a class="banner" href="#daily" id="banner"></a>
  {%- if ed.tldr %}
  <div class="brief">
    <p class="kicker">TL;DR</p>
    <ul>
      {%- for line in ed.tldr %}
      <li>{{ line }}</li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}

  <nav class="chips" aria-label="Filter">
    <button class="chip" aria-pressed="true" data-f="all">All</button>
    <button class="chip" aria-pressed="false" data-f="law">Became law</button>
    <button class="chip" aria-pressed="false" data-f="vote">Votes</button>
    <button class="chip" aria-pressed="false" data-f="debate">Being debated</button>
  </nav>

  <div id="feed">
  {%- for it in ed["items"] %}
  <article class="item" data-kind="{{ it.kind }}" data-topics="{{ it.topics|join(',') }}" data-bill="{{ it.bill }}" data-title="{{ it.short_title }}">
    <div class="meta"><span class="status{% if it.kind == 'law' %} law{% endif %}">{{ it.status }}</span><span>{% if it.bill.startswith(('C-','S-')) %}Bill {% endif %}{{ it.bill }} · {{ it.category }}</span><button class="follow">+ Follow</button></div>
    <h3>{{ it.headline }}</h3>
    <div class="label">{{ it.what_label }}</div>
    <p>{{ it.what|rich }}</p>
    {%- if it.stage %}
    <ol class="track" aria-label="Progress">
      {%- for st in stages %}
      <li class="{% if loop.index <= it.stage.done %}done{% elif it.stage.current and loop.index == it.stage.done + 1 %}now{% endif %}">{{ st }}</li>
      {%- endfor %}
    </ol>
    {%- endif %}
    <div class="you">
      <div class="label">{{ it.you_label }}</div>
      <p>{{ it.you|rich }}</p>
    </div>
    {%- if it.sides %}
    <details>
      <summary>What each side says</summary>
      <div class="sides">
        {%- for sd in it.sides %}
        <div class="side"><b>{{ sd.who }}</b>{{ sd.text }}</div>
        {%- endfor %}
      </div>
      {%- if it.sides_note %}
      <p class="note">{{ it.sides_note|rich }}</p>
      {%- endif %}
    </details>
    {%- endif %}
    {%- if it.poll %}
    <div class="poll" data-id="{{ it.id }}">
      <div class="q">{{ it.poll.q }}</div>
      <div class="opts"><button>Yes</button><button>No</button><button>Not sure</button></div>
      <div class="reveal">{{ it.poll.reveal|rich }}</div>
    </div>
    {%- endif %}
    <a class="src" href="{{ it.source.url }}" target="_blank" rel="noopener">{{ it.source.label }} →</a>
  </article>
  {%- endfor %}
  {%- if ed.also_law %}
  <div class="item" data-kind="law">
    <p class="kicker">Also became law</p>
    {%- for a in ed.also_law %}
    <div class="small"><span class="status law">Law</span><span><b>{{ a.title }}</b> (Bill {{ a.bill }}). {{ a.text }}</span></div>
    {%- endfor %}
  </div>
  {%- endif %}
  </div>
</section>

<!-- ============ PM ============ -->
<section class="view" id="v-pm">
  {%- if ed.pm %}
  <div class="item">
    <div class="meta"><span class="status">This week</span><span>Prime Minister {{ ed.pm.name }}</span></div>
    <h3>{{ ed.pm.headline }}</h3>
    <p>{{ ed.pm.intro }}</p>
    <div class="label">Where he's been</div>
    <ol class="tl">
      {%- for t in ed.pm.timeline %}
      <li class="{{ 'now' if t.state == 'now' else ('next' if t.state == 'next' else '') }}"><div class="when">{{ t.when }}</div><div class="where">{{ t.where }}</div><div class="what">{{ t.what }}</div></li>
      {%- endfor %}
    </ol>
    {%- if ed.pm.good_to_know %}
    <div class="you">
      <div class="label">Good to know</div>
      <p>{{ ed.pm.good_to_know|rich }}</p>
    </div>
    {%- endif %}
    <a class="src" href="{{ ed.pm.source.url }}" target="_blank" rel="noopener">{{ ed.pm.source.label }} →</a>
  </div>
  {%- endif %}
  <div class="item">
    <p class="kicker">How to read the PM's schedule</p>
    <p>The Prime Minister's Office posts a schedule every day. Some events say <b>"Closed to media"</b> or just <b>"Private meetings"</b>, which means the public isn't told who he met. Meetings with registered lobbyists still get reported, a few weeks later, in the Lobbying tab.</p>
  </div>
</section>

<!-- ============ LOBBYING ============ -->
<section class="view" id="v-lobby">
  {%- set lb = ed.lobbying %}
  {%- if lb %}
  <div class="item">
    <div class="meta"><span class="status">{{ lb.month }}</span><span>Registry of Lobbyists</span></div>
    <h3>{{ lb.headline }}</h3>
    <p>Every time a paid lobbyist has an arranged meeting with a senior federal official, it has to be reported. Here's what last month looked like.</p>
    <div class="stats">
      <div class="stat"><div class="n">{{ "{:,}".format(lb.total) }}</div><div class="d">reported lobbying meetings in {{ lb.month.split(' ')[0] }}</div></div>
      <div class="stat"><div class="n">{{ "{:,}".format(lb.prev_total) }}</div><div class="d">{{ lb.prev_label }}</div></div>
    </div>
    <div class="label">What they wanted to talk about</div>
    <div class="bars" id="bars"></div>
    <p class="note">One meeting can cover several topics.</p>
  </div>

  <div class="item">
    <p class="kicker">Most-lobbied office</p>
    <h3>{{ lb.top_office }}</h3>
    <p>In the latest monthly count, this office got more lobbying reports than any other part of government.</p>
    <div class="label">Reports by month</div>
    <div class="bars" id="pmo"></div>
  </div>

  <div class="item">
    <p class="kicker">Example from the registry</p>
    {%- for ex in lb.examples %}
    <div class="meet">
      <div class="who">{{ ex.who }}</div>
      <div class="with">{{ ex.with }}</div>
      {% for sj in ex.subjects %}<span class="pill">{{ sj }}</span>{% endfor %}
    </div>
    {%- endfor %}
    <div class="you">
      <div class="label">Keep in mind</div>
      <p>Lobbying is legal and regulated. Companies, unions, charities and advocacy groups all do it. A meeting shows who got access, not that they got what they wanted.</p>
    </div>
    <a class="src" href="{{ lb.source.url }}" target="_blank" rel="noopener">{{ lb.source.label }} →</a>
  </div>
  {%- endif %}
</section>

<!-- ============ LEARN ============ -->
<section class="view" id="v-learn">
  <div class="item quiz" id="d5"></div>

  <div class="item">
    <p class="kicker">Your civics meter</p>
    <h3 id="meter-t">Let's get started</h3>
    <div class="meter"><i id="meter"></i></div>
    <p class="note" id="meter-d">Play the Daily Savvy, learn terms and share your takes to fill it up.</p>
  </div>

  <div class="item">
    <p class="kicker">Words you'll see a lot</p>
    <p>Tap one to learn it.</p>
    <div class="glossary" id="gloss"></div>
  </div>

  <div class="item how">
    <p class="kicker">How a bill becomes law</p>
    <ol>
      <li><b>Introduced.</b> An MP or senator tables the bill.</li>
      <li><b>First vote.</b> MPs debate the general idea and vote. Officially called "second reading."</li>
      <li><b>Committee.</b> A small group of MPs studies it line by line and can change it.</li>
      <li><b>Final vote.</b> The whole House votes on the finished bill. Officially "third reading."</li>
      <li><b>Senate.</b> The Senate goes through the same steps.</li>
      <li><b>Law.</b> The Governor General signs it ("Royal Assent").</li>
    </ol>
  </div>

  <div class="item">
    <p class="kicker">Your vote counts</p>
    <h3>Make sure you're ready to vote</h3>
    <p>With a minority government, an election can come sooner than planned, like if a budget vote fails. Elections Canada lets you check or update your registration online in a few minutes.</p>
    <a class="cta" href="https://www.elections.ca/" target="_blank" rel="noopener">Go to Elections Canada</a>
  </div>
</section>


<!-- ============ YOU ============ -->
<section class="view" id="v-you">
  <div class="item" id="signup">
    <p class="kicker">Make it yours</p>
    <h3>Get the news you actually care about</h3>
    <p>Pick your topics and we'll email you what Parliament did about them. No spam, no party affiliation, unsubscribe anytime.</p>
    <div class="steps" style="margin-top:16px"><i></i><i></i><i></i><i></i></div>

    <div class="step" data-s="0">
      <div class="label">Your email</div>
      <input class="field" id="email" type="email" placeholder="you@example.com" autocomplete="email">
      <p class="note">We'll send a one-tap sign-in link. No password to remember.</p>
      <div class="err" id="err0"></div>
      <div class="row"><button class="btn" data-next>Continue</button></div>
    </div>

    <div class="step" data-s="1">
      <div class="label">What do you care about?</div>
      <p class="note" style="margin:0 0 6px">Pick at least one.</p>
      <div class="topics" id="topics"></div>
      <div class="err" id="err1"></div>
      <div class="row"><button class="btn ghost" data-back>Back</button><button class="btn" data-next>Continue</button></div>
    </div>

    <div class="step" data-s="2">
      <div class="label">How often?</div>
      <div class="radio">
        <label><input type="radio" name="freq" value="weekly" checked><span><b>Weekly digest</b><small>Sunday morning, about a 3-minute read</small></span></label>
        <label><input type="radio" name="freq" value="daily"><span><b>Daily</b><small>A short email on days something happens in your topics</small></span></label>
        <label><input type="radio" name="freq" value="alerts"><span><b>Only alerts</b><small>Just when a bill you follow moves to its next step</small></span></label>
      </div>
      <label class="check"><input type="checkbox" id="alerts" checked> Also alert me when a bill I follow moves to its next step</label>
      <div class="row"><button class="btn ghost" data-back>Back</button><button class="btn" data-next>Continue</button></div>
    </div>

    <div class="step" data-s="3">
      <div class="label">Almost done</div>
      <label class="check"><input type="checkbox" id="consent"> Yes, email me PoliSavvy updates on my chosen topics. I can unsubscribe anytime from any email.</label>
      <p class="note">We never sell your data or share it with parties, campaigns or advertisers. Your topics and takes are never shown publicly.</p>
      <div class="err" id="err3"></div>
      <div class="row"><button class="btn ghost" data-back>Back</button><button class="btn" data-next>Create my account</button></div>
    </div>
    <p class="demo">Demo only: nothing is sent and your details stay on this device.</p>
  </div>

  <div id="account" hidden>
    <div class="item">
      <p class="kicker">Your account</p>
      <h3 id="hi">You're in</h3>
      <div class="label">Your topics</div>
      <div class="topics" id="mytopics"></div>
      <div class="label">Bills you follow</div>
      <div id="myfollows"></div>
      <div class="label">Email</div>
      <p id="myfreq"></p>
    </div>
    <div class="item">
      <p class="kicker">Preview of your next email</p>
      <div class="mail">
        <div class="hd" id="mailhd"></div>
        <div class="bd" id="mailbd"></div>
      </div>
    </div>
    <div class="row"><button class="btn ghost" id="reset">Start over (demo)</button></div>
  </div>
</section>

<footer>
  Edition for {{ long_date }}, built from public records: LEGISinfo, House of Commons votes, the Prime Minister's itinerary and the Registry of Lobbyists. Party positions describe what was said in the House and are not endorsements or fact checks. Your takes, quiz answers and demo account stay on your device.
</footer>
</div>

