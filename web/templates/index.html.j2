  <a href="#daily" data-v="learn"><svg viewBox="0 0 24 24"><path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M7 10v5c2 2 8 2 10 0v-5"/></svg>Daily Savvy</a>
  <a href="#you" data-v="you"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-4 4-6 7-6s6 2 7 6"/></svg>For you</a>
</div></nav>
<div class="toast" id="toast"></div>

<div class="sheet-bg" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-t">
  <div class="sheet"><h4 id="sheet-t"></h4><p id="sheet-p"></p><button id="sheet-close">Got it</button></div>
</div>

<script>
const PP = {{ payload|tojson }};
/* ---------- tiny local store (per device) ---------- */
const store = {
  get(k, d){ try{ const v = localStorage.getItem("pp:"+k); return v ? JSON.parse(v) : d; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem("pp:"+k, JSON.stringify(v)); }catch(e){} }
};
const state = { terms: store.get("terms", []), polls: store.get("polls", {}) };

/* ---------- glossary ---------- */
const terms = PP.glossary;
const sheet = document.getElementById("sheet");
function openTerm(key){
  const t = terms[key]; if(!t) return;
  document.getElementById("sheet-t").textContent = t[0];
  document.getElementById("sheet-p").textContent = t[1];
  sheet.classList.add("open");
  if(!state.terms.includes(key)){ state.terms.push(key); store.set("terms", state.terms); }
  renderGloss(); renderMeter();
}
document.querySelectorAll(".term").forEach(b => b.addEventListener("click", e => { e.preventDefault(); openTerm(b.dataset.term); }));
document.getElementById("sheet-close").onclick = () => sheet.classList.remove("open");
sheet.addEventListener("click", e => { if(e.target === sheet) sheet.classList.remove("open"); });

const gloss = document.getElementById("gloss");
function renderGloss(){
  gloss.innerHTML = "";
  Object.keys(terms).forEach(k => {
    const b = document.createElement("button");
    b.textContent = terms[k][0];
    if(state.terms.includes(k)) b.classList.add("seen");
    b.onclick = () => openTerm(k);
    gloss.appendChild(b);
  });
}

/* ---------- filters ---------- */
document.querySelectorAll(".chip").forEach(c => c.addEventListener("click", () => {
  document.querySelectorAll(".chip").forEach(x => x.setAttribute("aria-pressed", x === c));
  const f = c.dataset.f;
  document.querySelectorAll("#feed [data-kind]").forEach(el => { el.hidden = !(f === "all" || el.dataset.kind === f); });
}));

/* ---------- polls ---------- */
document.querySelectorAll(".poll").forEach(p => {
  const id = p.dataset.id, btns = p.querySelectorAll("button");
  function show(i){ btns.forEach((b,j) => b.classList.toggle("picked", j === i)); p.classList.add("answered"); }
  if(state.polls[id] !== undefined) show(state.polls[id]);
  btns.forEach((b,i) => b.addEventListener("click", () => { state.polls[id] = i; store.set("polls", state.polls); show(i); renderMeter(); }));
});

/* ---------- lobbying bars ---------- */
function bars(el, rows){
  const max = Math.max(...rows.map(r => r[1]));
  el.innerHTML = rows.map(r => `<div class="bar"><span>${r[0]}</span><div class="t"><div class="f" style="width:${(r[1]/max*100).toFixed(1)}%"></div></div><span class="v">${r[1].toLocaleString()}</span></div>`).join("");
}
if(PP.lobbying){ bars(document.getElementById("bars"), PP.lobbying.topics);
bars(document.getElementById("pmo"), PP.lobbying.top_office_series); }

/* ---------- the Daily Savvy ---------- */
const LAUNCH = new Date(PP.launch + "T00:00:00");           // day #1 of the game
const RESET_HOUR = 6;                            // new quiz at 6 a.m. local
function gameDate(d = new Date()){ const x = new Date(d.getTime() - RESET_HOUR*3600e3); return new Date(x.getFullYear(), x.getMonth(), x.getDate()); }
function key(d){ return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
const TODAY = new Date(PP.quiz_date + "T00:00:00"), TODAY_KEY = PP.quiz_date;
const GAME_NO = Math.round((TODAY - LAUNCH) / 864e5) + 1;

const DQ = PP.daily5;

let day = store.get("d5:"+TODAY_KEY, {res:[], done:false});
let stats = store.get("d5stats", {played:0, dist:[0,0,0,0,0,0], streak:0, max:0, last:null, freezes:0, used:0});
let remind = store.get("d5remind", false);
const d5 = document.getElementById("d5");
const shuffle = arr => arr.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(x=>x[1]);

function header(){
  return `<div class="d5head"><div><p class="kicker" style="margin:0">The Daily Savvy · #${GAME_NO}</p><h3>${day.done ? "Done for today" : "What happened in Ottawa?"}</h3></div>
    <div class="streak"><b>\u{1F525} ${stats.streak}</b><span>streak</span></div></div>
    <div class="dots">${DQ.map((_,i)=>`<i class="${day.res[i]===true?"ok":day.res[i]===false?"no":i===day.res.length&&!day.done?"cur":""}"></i>`).join("")}</div>`;
}

function renderD5(){
  if(!DQ.length){ d5.innerHTML = `<p class="kicker">The Daily Savvy</p><h3>Today's Daily Savvy is on its way</h3><p>Check back soon.</p>`; return; }
  if(day.done) return renderResult();
  const i = day.res.length, q = DQ[i];
  let body;
  if(q.order){
    body = `<div class="order-pick" id="op"><em>Tap below in order</em></div><div class="ans" id="oa">${shuffle(q.order).map(t=>`<button>${t}</button>`).join("")}</div>
            <div class="nav"><button class="linkish" id="undo">Undo</button><span>${i+1} of ${DQ.length}</span></div>`;
  } else {
    body = `<div class="ans ${q.hl?"hl":""}">${q.opts.map((o,k)=>`<button data-k="${k}">${o}</button>`).join("")}</div><div class="nav"><span></span><span>${i+1} of ${DQ.length}</span></div>`;
  }
  d5.innerHTML = header() + `<span class="qtype">${q.type}</span><div class="qtext">${q.q}</div>${body}<div class="why" id="why"></div>`;
  d5.classList.remove("done");
  if(q.order){
    const picked = [], op = d5.querySelector("#op");
    const draw = () => { op.innerHTML = picked.length ? picked.map((t,n)=>`<span>${n+1}. ${t}</span>`).join("") : "<em>Tap below in order</em>"; };
    d5.querySelectorAll("#oa button").forEach(b => b.onclick = () => {
      picked.push(b.textContent); b.disabled = true; b.style.opacity=.35; draw();
      if(picked.length === q.order.length){ const ok = picked.every((t,n)=>t===q.order[n]); answer(ok); }
    });
    d5.querySelector("#undo").onclick = () => { const t = picked.pop(); d5.querySelectorAll("#oa button").forEach(b=>{ if(b.textContent===t){ b.disabled=false; b.style.opacity=1; } }); draw(); };
  } else {
    d5.querySelectorAll(".ans button").forEach(b => b.onclick = () => {
      const k = +b.dataset.k, ok = k === q.a;
      d5.querySelectorAll(".ans button").forEach((x,j)=>{ x.disabled=true; if(j===q.a) x.classList.add("right"); else if(j===k) x.classList.add("wrong"); });
      answer(ok);
    });
  }
}

function answer(ok){
  const i = day.res.length, q = DQ[i];
  day.res.push(ok); store.set("d5:"+TODAY_KEY, day);
  const last = i === DQ.length-1;
  const why = d5.querySelector("#why");
  why.innerHTML = `<b>${ok?"Correct.":"Not quite."}</b> ${q.why} <a class="src" style="margin:6px 0 0;display:inline-flex" href="${q.link}">Read the story →</a>
    <div class="row"><button class="btn" id="nx">${last?"See results":"Next"}</button></div>`;
  d5.classList.add("done"); why.style.display="block";
  d5.querySelector(".dots").innerHTML = DQ.map((_,j)=>`<i class="${day.res[j]===true?"ok":day.res[j]===false?"no":""}"></i>`).join("");
  d5.querySelector("#nx").onclick = () => { if(last) finish(); else renderD5(); };
  renderMeter();
}

function finish(){
  if(!day.done){
    const score = day.res.filter(Boolean).length;
    const prev = stats.last ? new Date(stats.last+"T00:00:00") : null;
    const gap = prev ? Math.round((TODAY - prev)/864e5) : null;
    if(gap === 1) stats.streak += 1;
    else if(gap === 2 && stats.freezes > 0){ stats.freezes -= 1; stats.used += 1; stats.streak += 1; day.froze = true; }
    else if(gap !== 0) stats.streak = 1;
    if(stats.streak > 0 && stats.streak % 7 === 0 && stats.freezes < 2) { stats.freezes += 1; day.earned = true; }
    stats.max = Math.max(stats.max, stats.streak);
    stats.played += 1; stats.dist[score] += 1; stats.last = TODAY_KEY;
    day.done = true; day.score = score;
    store.set("d5stats", stats); store.set("d5:"+TODAY_KEY, day);
  }
  renderResult(); renderBanner();
}

function grid(){ return day.res.map(r => r ? "\u{1F7E9}" : "\u{1F7E5}").join(""); }
function shareText(){ return `PoliSavvy Daily #${GAME_NO} · ${day.score}/5\n${grid()}\n\u{1F525} ${stats.streak}-day streak`; }
function nextReset(){ const n = new Date(); const r = new Date(n.getFullYear(), n.getMonth(), n.getDate(), RESET_HOUR); if(r <= n) r.setDate(r.getDate()+1); return r; }
function fmt(ms){ const t=Math.max(0,Math.floor(ms/1000)); return [Math.floor(t/3600), Math.floor(t%3600/60), t%60].map(v=>String(v).padStart(2,"0")).join(":"); }

function renderResult(){
  const avg = stats.played ? (stats.dist.reduce((a,c,k)=>a+c*k,0)/stats.played).toFixed(1) : "0";
  const maxd = Math.max(1, ...stats.dist);
  const msg = ["Rough day in Ottawa. Tomorrow's yours.","Good start. Read the Today tab and come back tomorrow.","Not bad at all.","Solid. You're paying attention.","So close to perfect.","Perfect score. You actually follow this stuff."][day.score];
  d5.classList.add("done");
  d5.innerHTML = header() + `
    <div class="result"><div class="big">${day.score}/5</div><div class="grid">${grid()}</div><div class="sub">${msg}</div>
      ${day.froze ? `<p class="note">A streak freeze saved your streak.</p>` : ""}${day.earned ? `<p class="note">7 days in a row: you earned a streak freeze.</p>` : ""}</div>
    <div class="row"><button class="btn" id="share">Copy result to share</button></div>
    <div class="sgrid"><div><b>${stats.played}</b><span>played</span></div><div><b>${avg}</b><span>avg score</span></div><div><b>${stats.streak}</b><span>current streak</span></div><div><b>${stats.max}</b><span>best streak</span></div></div>
    <div class="label">Your scores</div>
    <div class="dist">${[5,4,3,2,1,0].map(k=>`<div><span>${k}</span><i class="${k===day.score?"me":""}" style="width:${Math.max(8,stats.dist[k]/maxd*100)}%">${stats.dist[k]}</i></div>`).join("")}</div>
    <p class="note" style="margin-top:10px">❄️ Streak freezes: ${stats.freezes} of 2. Earn one every 7 days in a row. It covers you if you miss a day.</p>
    <div class="switch"><span>Next Daily Savvy in <span class="countdown" id="cd"></span></span></div>
    <label class="switch"><span>Remind me every morning</span><input type="checkbox" id="rm" ${remind?"checked":""}></label>
    <p class="demo"><button class="linkish" id="replay">Replay today (demo)</button></p>`;
  d5.querySelector("#share").onclick = () => copy(shareText());
  d5.querySelector("#rm").onchange = e => { remind = e.target.checked; store.set("d5remind", remind);
    toast(remind ? (acct ? "We'll remind you at 7 a.m." : "Create an account in For you to get reminders") : "Reminders off"); };
  d5.querySelector("#replay").onclick = () => {
    if(day.done){ stats.played--; stats.dist[day.score]--; store.set("d5stats", stats); }
    day = {res:[], done:false}; store.set("d5:"+TODAY_KEY, day); renderD5(); renderBanner(); renderMeter();
  };
  const tick = () => { const el = document.getElementById("cd"); if(el) el.textContent = fmt(nextReset() - new Date()); };
  tick(); clearInterval(window._cd); window._cd = setInterval(tick, 1000);
}

function renderBanner(){
  const b = document.getElementById("banner");
  if(!DQ.length){ b.hidden = true; return; }
  b.innerHTML = day.done
    ? `<div class="t"><b>Daily Savvy #${GAME_NO}: ${day.score}/5 ${grid()}</b><small>\u{1F525} ${stats.streak}-day streak · new quiz at 6 a.m.</small></div><span class="go">Stats</span>`
    : `<div class="t"><b>The Daily Savvy #${GAME_NO}</b><small>5 questions, 2 minutes${stats.streak?` · keep your \u{1F525} ${stats.streak}-day streak`:""}</small></div><span class="go">Play</span>`;
}
renderD5(); renderBanner();

/* ---------- civics meter ---------- */
function renderMeter(){
  const total = Object.keys(terms).length + DQ.length + document.querySelectorAll(".poll").length;
  const got = state.terms.length + day.res.length + Object.keys(state.polls).length;
  const pct = Math.round(got / total * 100);
  document.getElementById("meter").style.width = pct + "%";
  const lvl = pct >= 100 ? "Policy nerd" : pct >= 60 ? "Informed voter" : pct >= 25 ? "Getting the hang of it" : "Let's get started";
  document.getElementById("meter-t").textContent = lvl;
  document.getElementById("meter-d").textContent = `${pct}% this week · ${state.terms.length} terms learned · ${Object.keys(state.polls).length} takes shared`;
}
renderGloss(); renderMeter();


/* ---------- toast + copy ---------- */
function toast(m){ const t=document.getElementById("toast"); t.textContent=m; t.classList.add("show"); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("show"),1800); }
function copy(text){
  try{ navigator.clipboard.writeText(text).then(()=>toast("Copied. Paste it anywhere."), ()=>toast("Couldn't copy on this device")); }
  catch(e){ toast("Couldn't copy on this device"); }
}

/* ---------- account (demo, stored on this device) ---------- */
const TOPICS = PP.topics;
const EXTRA = PP.extras;
let acct = store.get("acct", null);
let follows = store.get("follows", []);
let draft = {email:"", topics:[], freq:"weekly", alerts:true};
let step = 0;

const topicsEl = document.getElementById("topics");
Object.entries(TOPICS).forEach(([k,v]) => {
  const b=document.createElement("button"); b.textContent=v; b.dataset.k=k;
  b.onclick=()=>{ b.classList.toggle("on"); draft.topics = [...topicsEl.querySelectorAll(".on")].map(x=>x.dataset.k); };
  topicsEl.appendChild(b);
});
function showStep(){
  document.querySelectorAll("#signup .step").forEach(el => el.hidden = +el.dataset.s !== step);
  document.querySelectorAll("#signup .steps i").forEach((el,i)=> el.classList.toggle("on", i<=step));
}
document.querySelectorAll("#signup [data-back]").forEach(b=>b.onclick=()=>{ step--; showStep(); });
document.querySelectorAll("#signup [data-next]").forEach(b=>b.onclick=()=>{
  if(step===0){ const e=document.getElementById("email").value.trim(); if(!/^\S+@\S+\.\S+$/.test(e)){ document.getElementById("err0").textContent="Enter a valid email."; return; } draft.email=e; document.getElementById("err0").textContent=""; }
  if(step===1){ if(!draft.topics.length){ document.getElementById("err1").textContent="Pick at least one topic."; return; } document.getElementById("err1").textContent=""; }
  if(step===2){ draft.freq=document.querySelector('input[name="freq"]:checked').value; draft.alerts=document.getElementById("alerts").checked; }
  if(step===3){ if(!document.getElementById("consent").checked){ document.getElementById("err3").textContent="Tick the box so we're allowed to email you."; return; } acct={...draft}; store.set("acct",acct); renderAccount(); toast("Account created"); return; }
  step++; showStep();
});

function billItems(){ return [...document.querySelectorAll("#feed article[data-bill]")].map(a=>({el:a, bill:a.dataset.bill, title:a.dataset.title, topics:a.dataset.topics.split(","), tag:a.querySelector(".status").textContent})); }

function renderAccount(){
  const signed = !!acct;
  document.getElementById("signup").hidden = signed;
  document.getElementById("account").hidden = !signed;
  document.querySelectorAll(".follow").forEach(b=>{ const bill=b.closest("article").dataset.bill; const on=follows.includes(bill); b.classList.toggle("on",on); b.textContent = on ? "Following" : "+ Follow"; });
  if(!signed){ showStep(); return; }
  document.getElementById("hi").textContent = "You're in, " + acct.email.split("@")[0];
  const mt=document.getElementById("mytopics"); mt.innerHTML="";
  Object.entries(TOPICS).forEach(([k,v])=>{ const b=document.createElement("button"); b.textContent=v; if(acct.topics.includes(k)) b.classList.add("on");
    b.onclick=()=>{ acct.topics = acct.topics.includes(k) ? acct.topics.filter(x=>x!==k) : [...acct.topics,k]; store.set("acct",acct); renderAccount(); }; mt.appendChild(b); });
  const items = billItems();
  document.getElementById("myfollows").innerHTML = follows.length
    ? follows.map(f=>{ const it=items.find(i=>i.bill===f); return `<div class="meet"><div class="who">${f}</div><div class="with">${it?it.title:""}</div></div>`; }).join("")
    : `<p class="note">Tap "+ Follow" on any bill in the Today tab to get an alert when it moves.</p>`;
  const fl={weekly:"Weekly digest, Sunday morning", daily:"Daily, on days with news in your topics", alerts:"Only alerts for bills you follow"}[acct.freq];
  document.getElementById("myfreq").textContent = fl + (acct.alerts && acct.freq!=="alerts" ? ", plus alerts for bills you follow." : ".") + " Sent to " + acct.email + ".";
  // email preview
  const pick = t => t.some(x=>acct.topics.includes(x));
  const rows = [...items.filter(i=>pick(i.topics)||follows.includes(i.bill)).map(i=>({tag:(follows.includes(i.bill)?"Following · ":"")+i.bill, title:i.title, text:i.el.querySelector(".you p").textContent})),
                ...EXTRA.filter(e=>pick(e.topics)).map(e=>({tag:e.tag,title:e.title,text:e.text}))];
  const names = acct.topics.map(k=>TOPICS[k]);
  document.getElementById("mailhd").innerHTML = `From: PoliSavvy<br>Subject: Your week in Ottawa: ${names.slice(0,2).join(", ")}${names.length>2?" and more":""}`;
  document.getElementById("mailbd").innerHTML = `<h4>Here's what Parliament did on what you care about</h4>` +
    (rows.length ? rows.map(r=>`<div class="it"><span class="tg">${r.tag}</span><b>${r.title}</b><span>${r.text}</span></div>`).join("")
                 : `<p class="note">Nothing new on your topics this week. Quiet weeks happen.</p>`) +
    `<p class="note" style="margin-top:12px">Play today's Daily Savvy · Manage topics · Unsubscribe</p>`;
}
document.querySelectorAll(".follow").forEach(b=>b.addEventListener("click",()=>{
  if(!acct){ toast("Create a free account to follow bills"); location.hash="#you"; return; }
  const bill=b.closest("article").dataset.bill;
  follows = follows.includes(bill) ? follows.filter(x=>x!==bill) : [...follows,bill]; store.set("follows",follows);
  renderAccount(); toast(follows.includes(bill) ? `Following ${bill}. We'll email you when it moves.` : `Unfollowed ${bill}`);
}));
document.getElementById("reset").onclick=()=>{ acct=null; follows=[]; store.set("acct",null); store.set("follows",[]); step=0; draft={email:"",topics:[],freq:"weekly",alerts:true}; topicsEl.querySelectorAll(".on").forEach(x=>x.classList.remove("on")); document.getElementById("consent").checked=false; renderAccount(); };
renderAccount();

/* ---------- tabs ---------- */
const views = { today:"today", pm:"pm", lobbying:"lobby", learn:"learn", daily:"learn", you:"you" };
function route(){
  const h = (location.hash || "#today").slice(1); const v = views[h] || "today";
  document.querySelectorAll(".view").forEach(s => s.classList.toggle("on", s.id === "v-" + v));
  document.querySelectorAll(".tabs a").forEach(a => a.classList.toggle("on", a.dataset.v === v));
  window.scrollTo(0, 0);
}
window.addEventListener("hashchange", route); route();
</script>
</body>
</html>
